generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  name          String?
  role          String         @default("USER") // 'USER' | 'ADMIN' | 'OWNER'
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  conversations           Conversation[]
  profile                 UserProfile?
  notifications           Notification[]
  confirmActions          ConfirmAction[]
  toolAuditLogs           ToolAuditLog[]
  bodyMetricEntries       BodyMetricEntry[]
  meals                   Meal[]
  workoutPlans            WorkoutPlan[]
  workoutSessions         WorkoutSession[]
  mindfulnessEntries      MindfulnessEntry[]
  fileAssets              FileAsset[]
  recommendationArtifacts RecommendationArtifact[]
  geoPreference           GeoPreference?
  userAttributes          UserAttribute[]
  agentWorkspaces         AgentWorkspace[]
  caseStates              CaseState[]
  appointments            Appointment[]
  reminders               Reminder[]
  clinicalEvents          ClinicalEvent[]

  @@map("users")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // 'specialist' | 'reminder' | 'milestone' | 'system'
  title     String
  message   String
  metadata  Json?     // { specialistId, conversationId, actionUrl }
  read      Boolean   @default(false)
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  birthDate   DateTime? @map("birth_date")
  gender      String?
  height      Float?
  weight      Float?
  health      Json?
  nutrition   Json?
  training    Json?
  mindfulness Json?
  goals       Json?
  settings    Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_profiles")
}

model UserAttribute {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  domain         String
  key            String
  value          Json
  unit           String?
  source         String   @default("agent")
  conversationId String?  @map("conversation_id")
  recordedAt     DateTime @default(now()) @map("recorded_at")
  validUntil     DateTime? @map("valid_until")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId, domain, key, recordedAt])
  @@index([userId, key, recordedAt])
  @@map("user_attributes")
}

model Conversation {
  id           String    @id @default(cuid())
  title        String?
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deletedAt    DateTime? @map("deleted_at") // soft-delete: null = active
  caseStatus   String    @default("active") @map("case_status") // 'open' | 'active' | 'pending' | 'completed' | 'archived'
  casePriority String    @default("normal") @map("case_priority") // 'urgent' | 'high' | 'normal' | 'low' | 'backlog'
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  messages                Message[]
  toolAuditLogs           ToolAuditLog[]
  fileAssets              FileAsset[]
  recommendationArtifacts RecommendationArtifact[]
  agentWorkspaces         AgentWorkspace[]
  caseState               CaseState?

  @@index([userId])
  @@map("conversations")
}

model AgentWorkspace {
  id             String       @id @default(cuid())
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agentId        String       @map("agent_id")
  round1Proposal Json?        @map("round1_proposal")
  round2Proposal Json?        @map("round2_proposal")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([conversationId, agentId])
  @@index([userId, conversationId, updatedAt])
  @@map("agent_workspaces")
}

model CaseState {
  id                   String       @id @default(cuid())
  userId               String       @map("user_id")
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId       String       @unique @map("conversation_id")
  conversation         Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ownerAgentId         String       @map("owner_agent_id")
  activeSpeakerAgentId String       @map("active_speaker_agent_id")
  protocolState        String       @map("protocol_state")
  consultTargetAgentId String?      @map("consult_target_agent_id")
  returnTargetAgentId  String?      @map("return_target_agent_id")
  consultReason        String?      @map("consult_reason")
  pendingHandoffAgentId String?     @map("pending_handoff_agent_id")
  checkpointReason     String?      @map("checkpoint_reason")
  takeoverTurns        Int          @default(0) @map("takeover_turns")
  loopCount            Int          @default(0) @map("loop_count")
  handoffCount         Int          @default(0) @map("handoff_count")
  stateSnapshot        Json?        @map("state_snapshot")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  @@index([userId, updatedAt])
  @@map("case_states")
}

model Message {
  id                String       @id @default(cuid())
  role              String       // 'user' | 'assistant'
  content           String
  domain            String?      // domain of the responding specialist (assistant messages only)
  specialistName    String?      @map("specialist_name") // e.g. "Nutrizionista"
  conversationId    String       @map("conversation_id")
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyToMessageId  String?      @map("reply_to_message_id")
  replyTo           Message?     @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies           Message[]    @relation("MessageReplies")
  attachments       Attachment[]
  deletedAt         DateTime?    @map("deleted_at") // soft-delete: null = active
  createdAt         DateTime     @default(now()) @map("created_at")

  @@index([conversationId, deletedAt])
  @@index([conversationId, createdAt])
  @@index([conversationId, replyToMessageId])
  @@map("messages")
}

model Attachment {
  id        String   @id @default(cuid())
  type      String
  fileName  String   @map("file_name")
  fileSize  Int      @map("file_size")
  mimeType  String   @map("mime_type")
  url       String
  metadata  String?
  messageId String   @map("message_id")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([messageId])
  @@map("attachments")
}

model ConfirmAction {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolName    String    @map("tool_name")
  payload     Json
  payloadHash String    @map("payload_hash")
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId, toolName])
  @@index([expiresAt])
  @@map("confirm_actions")
}

model ToolAuditLog {
  id             String        @id @default(cuid())
  userId         String        @map("user_id")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?       @map("conversation_id")
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  toolCallId     String        @map("tool_call_id")
  toolName       String        @map("tool_name")
  inputSummary   String        @map("input_summary")
  inputHash      String        @map("input_hash")
  status         String
  requestId      String        @map("request_id")
  errorCode      String?       @map("error_code")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
  @@index([requestId])
  @@map("tool_audit_logs")
}

// ─────────────────────────────────────────
// Tracker models (required by ContextPack)
// ─────────────────────────────────────────

model BodyMetricEntry {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metricType String   @map("metric_type")
  value      Float
  unit       String?
  recordedAt DateTime @default(now()) @map("recorded_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, recordedAt])
  @@index([userId, metricType, recordedAt])
  @@map("body_metric_entries")
}

model Meal {
  id              String   @id @default(cuid())
  createdByUserId String   @map("created_by_user_id")
  createdByUser   User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  mealType        String   @map("meal_type")
  date            DateTime @default(now())
  items           Json
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([createdByUserId, date])
  @@map("meals")
}

model WorkoutPlan {
  id         String           @id @default(cuid())
  userId     String           @map("user_id")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  weeklyDays Int              @map("weekly_days")
  sessions   Json
  createdAt  DateTime         @default(now()) @map("created_at")

  workoutSessions WorkoutSession[]

  @@index([userId])
  @@map("workout_plans")
}

model WorkoutSession {
  id              String       @id @default(cuid())
  userId          String       @map("user_id")
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId          String?      @map("plan_id")
  plan            WorkoutPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  durationMin     Int          @map("duration_min")
  perceivedEffort Int?         @map("perceived_effort")
  notes           String?
  date            DateTime     @default(now())
  createdAt       DateTime     @default(now()) @map("created_at")

  @@index([userId, date])
  @@map("workout_sessions")
}

model MindfulnessEntry {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood      Int?
  stress    Int?
  content   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("mindfulness_entries")
}

// ─────────────────────────────────────────
// File storage + AI artifacts
// ─────────────────────────────────────────

model FileAsset {
  id             String        @id @default(cuid())
  userId         String        @map("user_id")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?       @map("conversation_id")
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  filename       String
  mimeType       String        @map("mime_type")
  size           Int
  url            String?
  extractedText  String?       @map("extracted_text")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([userId])
  @@index([conversationId])
  @@map("file_assets")
}

model RecommendationArtifact {
  id                    String        @id @default(cuid())
  userId                String        @map("user_id")
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedConversationId String?       @map("related_conversation_id")
  relatedConversation   Conversation? @relation(fields: [relatedConversationId], references: [id], onDelete: SetNull)
  type                  String
  title                 String
  contentMarkdown       String        @map("content_markdown")
  createdAt             DateTime      @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([relatedConversationId])
  @@map("recommendation_artifacts")
}

// ─────────────────────────────────────────
// Geolocation (privacy-first, opt-in only)
// ─────────────────────────────────────────

model GeoPreference {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(false)
  // Coarse location — precision intentionally limited (≈1km max)
  country   String?
  region    String?
  city      String?
  timezone  String?
  latCoarse Float?   @map("lat_coarse") // rounded to 2 decimal places
  lonCoarse Float?   @map("lon_coarse")
  accuracy  String?  // 'country' | 'region' | 'city' | 'coarse'
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("geo_preferences")
}

model ApiErrorEvent {
  id         String   @id @default(cuid())
  endpoint   String
  errorCode  String   @map("error_code")
  statusCode Int      @map("status_code")
  message    String?
  requestId  String?  @map("request_id")
  userId     String?  @map("user_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([endpoint, createdAt])
  @@index([errorCode, createdAt])
  @@index([statusCode, createdAt])
  @@index([userId, createdAt])
  @@map("api_error_events")
}

// ─────────────────────────────────────────
// Appointments & Reminders
// ─────────────────────────────────────────

model Appointment {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  scheduledAt DateTime  @map("scheduled_at")
  durationMin Int?      @map("duration_min")
  specialist  String?   // e.g. "dietista", "medico-dello-sport"
  location    String?
  notes       String?
  status      String    @default("pending") // 'pending' | 'confirmed' | 'cancelled' | 'completed'
  cancelledAt DateTime? @map("cancelled_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  reminders   Reminder[]

  @@index([userId, scheduledAt])
  @@index([userId, status])
  @@map("appointments")
}

model Reminder {
  id            String       @id @default(cuid())
  userId        String       @map("user_id")
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointmentId String?      @map("appointment_id")
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  title         String
  message       String
  remindAt      DateTime     @map("remind_at")
  repeat        String?      @default("none") // 'none' | 'daily' | 'weekly' | 'monthly'
  sent          Boolean      @default(false)
  sentAt        DateTime?    @map("sent_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([userId, remindAt])
  @@index([sent, remindAt])
  @@map("reminders")
}

// ─────────────────────────────────────────
// Cartella Clinica — timeline eventi strutturati
// ─────────────────────────────────────────

model ClinicalEvent {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Tipo evento: diagnosi, farmaco, sintomo, referto ematico, visita, esame
  eventType      String   @map("event_type") // 'diagnosis' | 'medication' | 'symptom' | 'bloodwork' | 'visit' | 'exam'
  title          String
  description    String?
  domain         String   // 'health' | 'nutrition' | 'mindfulness' | 'training'

  // Tracciabilità: chi ha registrato e in quale conversazione
  agentId        String?  @map("agent_id")
  conversationId String?  @map("conversation_id")

  // Quando è avvenuto l'evento (≠ data di registrazione)
  eventDate      DateTime @map("event_date")
  validUntil     DateTime? @map("valid_until") // per farmaci (fine terapia)

  // Stato e severità
  severity       String?  // 'low' | 'medium' | 'high'
  status         String   @default("active") // 'active' | 'resolved' | 'ongoing' | 'stopped'

  // Dati strutturati specifici per tipo
  metadata       Json?

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([userId, eventDate])
  @@index([userId, eventType, eventDate])
  @@index([userId, domain, eventDate])
  @@map("clinical_events")
}

// ─────────────────────────────────────────
// Agent Performance Tracking
// ─────────────────────────────────────────

model AgentPerformanceLog {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  conversationId String   @map("conversation_id")
  agentId        String   @map("agent_id")
  requestId      String   @map("request_id")
  round          Int      // 1 o 2
  domain         String
  confidence     Float    // 0.0 - 1.0 (da AgentProposal.confidence)
  proposalHash   String   @map("proposal_hash")
  durationMs     Int?     @map("duration_ms")
  wasSelected    Boolean  @map("was_selected")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([agentId, createdAt])
  @@index([userId, createdAt])
  @@index([conversationId])
  @@map("agent_performance_logs")
}

// ─────────────────────────────────────────
// Long-term memory — summaries across convos
// ─────────────────────────────────────────

model ConversationSummary {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  conversationId String   @unique @map("conversation_id")
  summary        String   // 200-300 chars max, generated after turn
  domain         String   @default("general")
  messageCount   Int      @default(0) @map("message_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([userId, updatedAt])
  @@map("conversation_summaries")
}

// ─────────────────────────────────────────
// Message Reviews — strumento di studio/miglioramento
// ISOLATO: nessuna FK a tabelle utente.
// userHash = SHA-256(userId).slice(0,16) — opaco, non tracciabile.
// ─────────────────────────────────────────

model MessageReview {
  id             String   @id @default(cuid())
  // Identificatori opachi — nessuna relazione a tabelle user/conversation
  userHash       String   @map("user_hash")        // hash anonimizzato, non FK
  messageId      String   @map("message_id")        // ID del messaggio AI valutato
  conversationId String   @map("conversation_id")   // opaque, non FK
  // Contesto AI per analisi
  agentId        String?  @map("agent_id")
  agentName      String?  @map("agent_name")
  domain         String?
  // Valutazione
  rating         Int      // 1-5 stelle
  comment        String?  // commento libero (opzionale)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([userHash, messageId])
  @@index([agentId, rating])
  @@index([domain, rating])
  @@index([createdAt])
  @@map("message_reviews")
}

// ─────────────────────────────────────────
// Moderation — log of flagged content
// ─────────────────────────────────────────

model ModerationLog {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  conversationId String?  @map("conversation_id")
  requestId      String   @map("request_id")
  flagType       String   @map("flag_type") // 'self_harm' | 'violence' | 'medical_emergency' | 'pii'
  severity       String   // 'low' | 'medium' | 'high'
  excerpt        String?  // first 200 chars of flagged message (hashed/truncated)
  action         String   // 'warn' | 'block' | 'escalate'
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([flagType, createdAt])
  @@map("moderation_logs")
}
